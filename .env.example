POSTGRES_DB=hiresense
POSTGRES_USER=hiresense
POSTGRES_PASSWORD=replace-with-a-long-alphanumeric-database-password

JWT_SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60

INTERVIEWER_NAME=HireSense Interviewer
INTERVIEWER_EMAIL=interviewer@hiresense.com
INTERVIEWER_PASSWORD=replace-with-your-own-strong-password

FRONTEND_URL=http://localhost:5173

# Private document storage and upload limits
STORAGE_ROOT=storage
CV_MAX_FILE_SIZE_MB=10
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_TIMEOUT_SECONDS=60

# Backend-only Gemini credentials. Never expose this key in VITE_* variables.
GEMINI_API_KEY=your-real-api-key
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=60
