POSTGRES_DB=hiresense
POSTGRES_USER=hiresense
POSTGRES_PASSWORD=replace-with-a-long-alphanumeric-database-password

# Local backend connection. Docker Compose supplies its internal database URL.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

JWT_SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60

INTERVIEWER_NAME=HireSense Interviewer
INTERVIEWER_EMAIL=interviewer@hiresense.com
INTERVIEWER_PASSWORD=replace-with-your-own-strong-password

FRONTEND_URL=http://localhost:5173

# Private document storage and upload limits
STORAGE_ROOT=storage
CV_MAX_FILE_SIZE_MB=10
CV_MAX_PAGES=40
CV_MAX_CHARACTERS=150000
CV_MIN_EXTRACT_CHARACTERS=80
SCREENING_BATCH_MAX_APPLICATIONS=50
SCREENING_EVIDENCE_TOP_K=6
# Increment deliberately when changing a cloud model alias's evaluation policy.
SCREENING_ENGINE_REVISION=semantic-evidence-v1
SCREENING_REQUEST_INTERVAL_SECONDS=4.1
KNOWLEDGE_PDF_MAX_FILE_SIZE_MB=15
KNOWLEDGE_PDF_MAX_PAGES=100

# Google Forms response intake. Copy the spreadsheet ID from the linked
# response Sheet URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSfMduzyxs15tGH8LpoVSV6Nqs_0S3udgPQ83n6mQZmY4w_OIg/viewform
GOOGLE_FORMS_SPREADSHEET_ID=
GOOGLE_FORMS_SHEET_NAME=Form Responses 1
GOOGLE_FORMS_TIMESTAMP_COLUMN=Timestamp
GOOGLE_FORMS_NAME_COLUMN=Name
GOOGLE_FORMS_EMAIL_COLUMN=Email Address
GOOGLE_FORMS_PHONE_COLUMN=Phone
GOOGLE_FORMS_LINKEDIN_COLUMN=LinkedIn
GOOGLE_FORMS_PORTFOLIO_COLUMN=Portfolio
GOOGLE_FORMS_LOCATION_COLUMN=Location
GOOGLE_FORMS_CV_COLUMN=Upload CV
# Required Form question used to route each response to its job posting.
GOOGLE_FORMS_JOB_COLUMN=Job Posting
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_TIMEOUT_SECONDS=60

# Backend-only Gemini credentials. Never expose this key in VITE_* variables.
GEMINI_API_KEY=your-real-api-key
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=60

# Shared MCP clients. Endpoints/timeouts are centralized in root mcp.json.
MCP_CONFIG_FILE=mcp.json
MCP_PROFILE=local

# Discord job-posting MCP server. The bot token must never be exposed to the
# frontend or placed in a VITE_* variable.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_API_BASE_URL=https://discord.com/api/v10
DISCORD_BOT_TIMEOUT_SECONDS=15

# Reusable job-post defaults. Empty optional values are omitted from the post.
DISCORD_DEFAULT_HEADING=BJIT is Hiring!
JOB_POST_DEFAULT_APPLICATION_URL=
JOB_POST_DEFAULT_CONTACT_EMAIL=
JOB_POST_DEFAULT_LOCATION=
JOB_POST_DEFAULT_APPLICATION_DEADLINE=
JOB_POST_DEFAULT_INSTRUCTIONS=

# Interview invitations. Keep credentials in this root .env, never VITE_* variables.
INTERVIEW_COMPANY_NAME=BJIT
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=interviews@hiresense.test
SMTP_FROM_NAME=HireSense
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=15
INTERVIEW_REPLY_TO_EMAIL=interviews@hiresense.test

# LiveKit Cloud for remote interviews. Create a Cloud project and copy its
# Project URL and private API credentials here; never use VITE_* for secrets.
LIVEKIT_CLOUD_URL=
LIVEKIT_CLOUD_API_KEY=
LIVEKIT_CLOUD_API_SECRET=

# Live transcription: worker-only Deepgram key; never a VITE_* variable.
# Keep disabled until configured. Both participants must explicitly consent.
TRANSCRIPTION_ENABLED=false
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000
TRANSCRIPTION_INTERIM_RESULTS=true
# Generate a separate random secret of at least 32 characters, shared only by backend/worker.
TRANSCRIPTION_WORKER_SECRET=
TRANSCRIPTION_AGENT_NAME=hiresense-transcriber
TRANSCRIPTION_RETENTION_DAYS=30
TRANSCRIPTION_QUEUE_SIZE=128
TRANSCRIPTION_MAX_RETRIES=3
TRANSCRIPTION_FLUSH_SECONDS=4

INTERVIEW_LINK_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
INTERVIEW_JOIN_BASE_URL=http://localhost:5173
LIVEKIT_TOKEN_TTL_SECONDS=120
LIVEKIT_API_TIMEOUT_SECONDS=5
INTERVIEW_LINK_MAX_DAYS=30
CANDIDATE_SESSION_MINUTES=120
CANDIDATE_COOKIE_SECURE=false
CANDIDATE_PUBLIC_RATE_LIMIT=20
CANDIDATE_WAITING_HEARTBEAT_SECONDS=45

# Optional website-only Quick Tunnel; no Cloudflare account/token required.
# The tunnel control endpoint is bound only to localhost.
CLOUDFLARE_METRICS_PORT=20241
