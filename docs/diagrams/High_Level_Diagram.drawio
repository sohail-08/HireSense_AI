        <mxCell id="tjdCE_rOWPLue9648ybU-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#EEFBF7;strokeColor=#25A779;strokeWidth=2;fontSize=18;fontColor=#172033;align=center;verticalAlign=middle;shadow=1;spacing=10;" value="&lt;b&gt;CANDIDATE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Joins through a unique link&lt;br&gt;and attends the interview" vertex="1">
          <mxGeometry height="124" width="252" x="90" y="842" as="geometry" />
        </mxCell>
        <mxCell id="tjdCE_rOWPLue9648ybU-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#EEF4FF;strokeColor=#5B83E8;strokeWidth=2;fontSize=19;fontColor=#172033;align=center;verticalAlign=middle;shadow=1;spacing=10;" value="&lt;b&gt;INTERVIEWER&lt;/b&gt;&lt;br&gt;&lt;br&gt;Creates jobs, uploads CVs&lt;br&gt;and manages interviews&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2457D6&quot;&gt;&lt;b&gt;Always controls publishing&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="153" width="282" x="20" y="387" as="geometry" />
        </mxCell>
        <mxCell id="tjdCE_rOWPLue9648ybU-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#172A52;strokeColor=#172A52;fontSize=20;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=26;" value="&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18));&quot;&gt;HireSense AI Recruitment Platform&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="1490" x="-20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="tjdCE_rOWPLue9648ybU-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0F5FF;strokeColor=#7DA0ED;strokeWidth=2;fontSize=18;fontColor=#42506A;align=left;verticalAlign=top;spacing=20;spacingTop=18;" value="&lt;font&gt;&lt;b&gt;1. Create job&lt;br&gt;&amp;amp; publish&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Chat request&lt;br&gt;Use previous history&lt;br&gt;Create profile + post&lt;br&gt;Review and approve&lt;br&gt;Publish on command&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2457D6&quot;&gt;&lt;b&gt;Public post is separate&lt;br&gt;from internal scoring&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="390" width="230" x="370" y="425" as="geometry" />
        </mxCell>
        <mxCell id="tjdCE_rOWPLue9648ybU-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF8E8;strokeColor=#E9B949;strokeWidth=2;fontSize=18;fontColor=#42506A;align=left;verticalAlign=top;spacing=20;spacingTop=18;" value="&lt;font&gt;&lt;b&gt;3. Screen, Score&amp;nbsp; &amp;amp; shortlist CVs&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;CV upload&lt;br&gt;Read CV information&lt;br&gt;Check must-have criteria&lt;br&gt;Score eligible candidates&lt;br&gt;Create ranked shortlist&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#9A6810&quot;&gt;&lt;b&gt;CVs enter HireSense&lt;br&gt;by uploading them&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="390" width="230" x="656" y="425" as="geometry" />
        </mxCell>
        <mxCell id="tjdCE_rOWPLue9648ybU-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFBF6;strokeColor=#42B98D;strokeWidth=2;fontSize=18;fontColor=#42506A;align=left;verticalAlign=top;spacing=20;spacingTop=18;" value="&lt;font&gt;&lt;b&gt;4. Conduct the&lt;br&gt;interview&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Schedule one-to-one call&lt;br&gt;Send unique join link&lt;br&gt;Video conversation&lt;br&gt;Live speaker transcript&lt;br&gt;Reconnect if interrupted&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#117654&quot;&gt;&lt;b&gt;Raw audio and video&lt;br&gt;are not retained&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="390" width="220" x="950" y="425" as="geometry" />
        </mxCell>
        <mxCell id="tjdCE_rOWPLue9648ybU-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F7F0FF;strokeColor=#9C6ADE;strokeWidth=2;fontSize=18;fontColor=#42506A;align=left;verticalAlign=top;spacing=20;spacingTop=18;" value="&lt;font&gt;&lt;b&gt;5. Analyse &amp;amp;&lt;br&gt;compare&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Review job-related Q&amp;amp;A&lt;br&gt;Check trusted references&lt;br&gt;Combine CV + interview&lt;br&gt;Compare candidates&lt;br&gt;Create final report&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6636A6&quot;&gt;&lt;b&gt;Every conclusion has&lt;br&gt;supporting evidence&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="390" width="230" x="1220" y="425" as="geometry" />
        </mxCell>
        <mxCell id="tjdCE_rOWPLue9648ybU-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#EEFBF7;strokeColor=#25A779;strokeWidth=2;fontSize=18;fontColor=#172033;align=center;verticalAlign=middle;shadow=1;spacing=10;" value="&lt;b&gt;2. EXTERNAL PLATFORM&lt;/b&gt;&lt;br&gt;&lt;br&gt;External channel&lt;br&gt;Job-post for demonstrating automation&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#117654&quot;&gt;&lt;b&gt;Post includes Email address &amp;amp; application procedure&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="198" width="266" x="620" y="172" as="geometry" />
        </mxCell>
        <mxCell id="tjdCE_rOWPLue9648ybU-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F7F0FF;strokeColor=#9C6ADE;strokeWidth=2;fontSize=18;fontColor=#172033;align=center;verticalAlign=middle;shadow=1;spacing=10;" value="&lt;b&gt;6. CANDIDATE REPORT&lt;/b&gt;&lt;br&gt;&lt;br&gt;Scores, strengths, gaps&lt;br&gt;and supporting evidence&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6636A6&quot;&gt;&lt;b&gt;Human makes the final decision&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="181" width="266" x="1170" y="864" as="geometry" />
